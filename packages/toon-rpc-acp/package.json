{
  "name": "@reddb-io/toon-rpc-acp",
  "version": "0.29.9",
  "private": true,
  "description": "Client for this repository's own legacy, terminal ACP-style REST contract. Not IBM/BeeAI ACP, not Zed's Agent Client Protocol, not interoperable with either.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "acp",
    "legacy",
    "toon",
    "toon-rpc"
  ],
  "license": "MIT",
  "homepage": "https://github.com/reddb-io/toon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/toon.git",
    "directory": "packages/toon-rpc-acp"
  },
  "bugs": {
    "url": "https://github.com/reddb-io/toon/issues"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@reddb-io/toon": "workspace:*"
  }
}
