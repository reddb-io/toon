{
  "name": "@reddb-io/toon-rpc",
  "version": "0.1.0",
  "description": "TOON-RPC client and server. JSON-RPC 2.0 semantics with TOON serialization.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "/server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "toon",
    "toon-rpc",
    "rpc",
    "json-rpc"
  ],
  "license": "MIT",
  "homepage": "https://github.com/reddb-io/toon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/toon.git",
    "directory": "packages/toon-rpc"
  },
  "bugs": {
    "url": "https://github.com/reddb-io/toon/issues"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@reddb-io/toon": ">=0.28"
  }
}
