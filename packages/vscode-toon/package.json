{
  "name": "reddb-toon",
  "displayName": "RedDB Toon",
  "description": "Syntax highlighting, strict-decode diagnostics, formatting and JSON↔TOON conversion for official TOON v4.1, TOONL streams, and the reddb-io userland wire extensions.",
  "version": "0.30.3",
  "private": true,
  "publisher": "reddb-io",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:toon",
    "onLanguage:toonl",
    "onLanguage:json"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "toon",
    "toonl",
    "syntax",
    "highlighting",
    "grammar",
    "formatter",
    "diagnostics",
    "json"
  ],
  "scripts": {
    "build": "node scripts/vendor-codec.mjs",
    "test": "node --test test/grammar.test.mjs test/core.test.mjs"
  },
  "contributes": {
    "languages": [
      {
        "id": "toon",
        "aliases": [
          "RedDB TOON",
          "TOON"
        ],
        "extensions": [
          ".toon"
        ],
        "mimetypes": [
          "text/toon"
        ],
        "configuration": "./language-configuration-toon.json"
      },
      {
        "id": "toonl",
        "aliases": [
          "RedDB TOONL",
          "TOONL"
        ],
        "extensions": [
          ".toonl"
        ],
        "mimetypes": [
          "application/toonl"
        ],
        "configuration": "./language-configuration-toonl.json"
      }
    ],
    "grammars": [
      {
        "language": "toon",
        "scopeName": "source.toon",
        "path": "./syntaxes/toon.tmLanguage.json"
      },
      {
        "language": "toonl",
        "scopeName": "source.toonl",
        "path": "./syntaxes/toonl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.toon.codeblock",
        "path": "./syntaxes/toon-markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.toon": "toon",
          "meta.embedded.block.toonl": "toonl"
        }
      }
    ],
    "commands": [
      {
        "command": "reddbToon.convertJsonToToon",
        "title": "Convert JSON to TOON",
        "category": "RedDB Toon"
      },
      {
        "command": "reddbToon.convertToonToJson",
        "title": "Convert TOON to JSON",
        "category": "RedDB Toon"
      }
    ],
    "configuration": {
      "title": "RedDB Toon",
      "properties": {
        "reddbToon.validate": {
          "type": "boolean",
          "default": true,
          "description": "Strict-decode .toon and .toonl files and report the first error as a diagnostic."
        },
        "reddbToon.delimiter": {
          "type": "string",
          "enum": [
            "comma",
            "tab",
            "pipe"
          ],
          "default": "comma",
          "description": "Delimiter used when formatting TOON and converting JSON to TOON."
        }
      }
    }
  },
  "homepage": "https://github.com/reddb-io/tq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/tq.git",
    "directory": "packages/vscode-toon"
  },
  "bugs": {
    "url": "https://github.com/reddb-io/tq/issues"
  }
}
