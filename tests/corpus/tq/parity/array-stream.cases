# Array ordering, eager stream controls, search, and matrix operations.
case: "array-sort"
filter: "sort"
input: "[3,1,2,1]"
output: "[1,1,2,3]\n"

case: "array-sort-type-error"
filter: "sort"
input: "1"
error: "cannot be sorted"

case: "array-sort-total-order"
filter: "sort"
input: "[{\"b\":1},{\"a\":2},{\"a\":1},[2],[1,2],[1],\"b\",\"a\",1.5,1,true,true,false,false,null,null]"
output: "[null,null,false,false,true,true,1,1.5,\"a\",\"b\",[1],[1,2],[2],{\"a\":1},{\"a\":2},{\"b\":1}]\n"

case: "array-reverse"
filter: "reverse"
input: "[1,2,3]"
output: "[3,2,1]\n"

case: "array-reverse-type-error"
filter: "reverse"
input: "\"abc\""
error: "Cannot index string with number"

case: "array-min"
filter: "min"
input: "[3,1,2]"
output: "1\n"

case: "array-max-empty"
filter: "max"
input: "[]"
output: "null\n"

case: "array-min-type-error"
filter: "min"
input: "1"
error: "cannot be iterated over"

case: "array-unique-by"
filter: "unique_by(.k)"
input: "[{\"k\":2,\"v\":\"b\"},{\"k\":1,\"v\":\"a\"},{\"k\":2,\"v\":\"c\"}]"
output: "[{\"k\":1,\"v\":\"a\"},{\"k\":2,\"v\":\"b\"}]\n"

case: "array-unique-by-type-error"
filter: "unique_by(.)"
input: "1"
error: "Cannot iterate over number"

case: "array-unique-by-stream-key"
filter: "unique_by(.a,.b)"
input: "[{\"a\":1,\"b\":2},{\"a\":1,\"b\":1}]"
output: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}]\n"

case: "array-flatten-all"
filter: "flatten"
input: "[1,[2,[3]]]"
output: "[1,2,3]\n"

case: "array-flatten-depth"
filter: "flatten(1)"
input: "[1,[2,[3]]]"
output: "[1,2,[3]]\n"

case: "array-flatten-type-error"
filter: "flatten"
input: "1"
error: "Cannot iterate over number"

case: "array-flatten-negative-error"
filter: "flatten(-1)"
input: "[]"
error: "flatten depth must not be negative"

case: "stream-range-end"
filter: "range(3)"
input: "null"
output: "0\n1\n2\n"

case: "stream-range-bounds"
filter: "range(2;5)"
input: "null"
output: "2\n3\n4\n"

case: "stream-range-step"
filter: "range(5;0;-2)"
input: "null"
output: "5\n3\n1\n"

case: "stream-range-zero-step"
filter: "range(1;2;0)"
input: "null"
output: ""

case: "stream-range-type-error"
filter: "range(\"x\")"
input: "null"
error: "Range bounds must be numeric"

case: "stream-range-stream-bound"
filter: "range(1,2)"
input: "null"
output: "0\n0\n1\n"

case: "stream-range-fractional-step"
filter: "range(0;1;0.25)"
input: "null"
output: "0\n0.25\n0.5\n0.75\n"

case: "stream-unbounded-range-unsupported"
filter: "range"
input: "null"
error: "unsupported identifier `range`"
divergence: "tq reports deferred unbounded range through its unsupported-identifier contract"
jq-output: "error: range/0 is not defined"

case: "stream-first-array"
filter: "first"
input: "[1,2]"
output: "1\n"

case: "stream-last-empty-array"
filter: "last"
input: "[]"
output: "null\n"

case: "stream-first-type-error"
filter: "first"
input: "\"x\""
error: "Cannot index string with number"

case: "stream-last-null"
filter: "last"
input: "null"
output: "null\n"

case: "stream-nth-array"
filter: "nth(1)"
input: "[1,2,3]"
output: "2\n"

case: "stream-first-generator"
filter: "first(.[])"
input: "[1,2]"
output: "1\n"

case: "stream-last-generator"
filter: "last(.[])"
input: "[1,2]"
output: "2\n"

case: "stream-nth-generator"
filter: "nth(1;.[])"
input: "[1,2,3]"
output: "2\n"

case: "stream-nth-generator-negative-error"
filter: "nth(-1;.[])"
input: "[1,2]"
error: "nth doesn't support negative indices"

case: "stream-nth-fractional-array-index"
filter: "nth(1.5)"
input: "[1,2,3]"
output: "2\n"

case: "stream-nth-negative-array-index"
filter: "nth(-1)"
input: "[1,2,3]"
output: "3\n"

case: "stream-nth-type-error"
filter: "nth(1)"
input: "1"
error: "Cannot index number with number"

case: "stream-limit"
filter: "limit(2;.[])"
input: "[1,2,3]"
output: "1\n2\n"

case: "stream-limit-negative"
filter: "limit(-1;.[])"
input: "[1,2]"
output: "1\n2\n"

case: "stream-until"
filter: "until(.>=3;.+1)"
input: "0"
output: "3\n"

case: "stream-while"
filter: "while(.<3;.+1)"
input: "0"
output: "0\n1\n2\n"

case: "stream-any-array"
filter: "any"
input: "[false,null,1]"
output: "true\n"

case: "stream-all-array"
filter: "all"
input: "[true,1]"
output: "true\n"

case: "stream-any-condition"
filter: "any(.>2)"
input: "[1,3]"
output: "true\n"

case: "stream-all-condition"
filter: "all(.>0)"
input: "[1,2,3]"
output: "true\n"

case: "stream-any-generator-condition"
filter: "any(.[];.>2)"
input: "[1,3]"
output: "true\n"

case: "stream-all-generator-condition"
filter: "all(.[];.>0)"
input: "[1,2,3]"
output: "true\n"

case: "stream-any-type-error"
filter: "any"
input: "1"
error: "Cannot iterate over number"

case: "stream-any-boolean-type-error"
filter: "any"
input: "true"
error: "Cannot iterate over boolean"

case: "stream-all-null-type-error"
filter: "all"
input: "null"
error: "Cannot iterate over null"

case: "stream-any-object-type-error"
filter: "any"
input: "{}"
error: "Cannot iterate over object"

case: "stream-all-string-type-error"
filter: "all"
input: "\"x\""
error: "Cannot iterate over string"

case: "array-contains-recursive"
filter: "contains({\"a\":[2]})"
input: "{\"a\":[1,2,3]}"
output: "true\n"

case: "array-inside"
filter: "inside([1,2,3])"
input: "[2]"
output: "true\n"

case: "array-contains-string"
filter: "contains(\"an\")"
input: "\"banana\""
output: "true\n"

case: "array-contains-missing-array-value"
filter: "contains([4])"
input: "[1,2,3]"
output: "false\n"

case: "array-contains-missing-object-key"
filter: "contains({\"b\":1})"
input: "{\"a\":1}"
output: "false\n"

case: "array-contains-mismatched-object-value"
filter: "contains({\"a\":2})"
input: "{\"a\":1}"
output: "false\n"

case: "array-contains-type-error"
filter: "contains(1)"
input: "\"x\""
error: "cannot have their containment checked"

case: "array-string-indices"
filter: "indices(\"ana\")"
input: "\"banana\""
output: "[1,3]\n"

case: "array-subarray-indices"
filter: "indices([2,3])"
input: "[1,2,3,2,3]"
output: "[1,3]\n"

case: "array-value-indices"
filter: "indices(2)"
input: "[1,2,3,2]"
output: "[1,3]\n"

case: "array-index"
filter: "index(2)"
input: "[1,2,3,2]"
output: "1\n"

case: "array-index-missing"
filter: "index(9)"
input: "[1,2,3]"
output: "null\n"

case: "array-rindex"
filter: "rindex(\"an\")"
input: "\"banana\""
output: "3\n"

case: "array-rindex-missing"
filter: "rindex(\"z\")"
input: "\"banana\""
output: "null\n"

case: "array-indices-empty-pattern"
filter: "indices([])"
input: "[1,2]"
output: "[]\n"

case: "array-indices-null"
filter: "indices(1)"
input: "null"
output: "null\n"

case: "array-indices-type-error"
filter: "indices(1)"
input: "\"abc\""
error: "Cannot index string with number"

case: "array-transpose-ragged"
filter: "transpose"
input: "[[1,2],[3]]"
output: "[[1,3],[2,null]]\n"

case: "array-transpose-empty"
filter: "transpose"
input: "[]"
output: "[]\n"

case: "array-transpose-type-error"
filter: "transpose"
input: "[1,2]"
error: "Cannot index number with number"

case: "array-transpose-input-type-error"
filter: "transpose"
input: "1"
error: "Cannot index number with number"

case: "stream-repeat-deferred"
filter: "repeat(.;2)"
input: "null"
error: "unsupported identifier `repeat`"
divergence: "tq keeps repeat/2 deferred for its eager evaluator"
jq-output: "error: repeat/2 is not defined"
