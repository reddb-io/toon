# Type inspection, selectors, numeric classification, and array coercion.
case: "types-type-null"
filter: "type"
input: "null"
output: "\"null\"\n"

case: "types-type-every-json-kind"
filter: ".[]|type"
input: "[null,false,1,\"x\",[],{}]"
output: "\"null\"\n\"boolean\"\n\"number\"\n\"string\"\n\"array\"\n\"object\"\n"

case: "types-values"
filter: ".[]|values"
input: "[null,false,1,\"x\",[],{}]"
output: "false\n1\n\"x\"\n[]\n{}\n"

case: "types-nulls"
filter: ".[]|nulls"
input: "[null,false,1,\"x\",[],{}]"
output: "null\n"

case: "types-booleans"
filter: ".[]|booleans"
input: "[null,false,true,1,\"x\",[],{}]"
output: "false\ntrue\n"

case: "types-numbers"
filter: ".[]|numbers"
input: "[null,false,1,2.5,\"x\",[],{}]"
output: "1\n2.5\n"

case: "types-strings"
filter: ".[]|strings"
input: "[null,false,1,\"x\",\"\",[],{}]"
output: "\"x\"\n\"\"\n"

case: "types-arrays"
filter: ".[]|arrays"
input: "[null,false,1,\"x\",[],[1],{}]"
output: "[]\n[1]\n"

case: "types-objects"
filter: ".[]|objects"
input: "[null,false,1,\"x\",[],{}, {\"a\":1}]"
output: "{}\n{\"a\":1}\n"

case: "types-scalars"
filter: ".[]|scalars"
input: "[null,false,1,\"x\",[],{}]"
output: "null\nfalse\n1\n\"x\"\n"

case: "types-iterables"
filter: ".[]|iterables"
input: "[null,false,1,\"x\",[],{}]"
output: "[]\n{}\n"

case: "types-isnan-ordinary-values"
filter: ".[]|isnan"
input: "[null,false,1,\"x\",[],{}]"
output: "false\nfalse\nfalse\nfalse\nfalse\nfalse\n"

case: "types-isinfinite-ordinary-values"
filter: ".[]|isinfinite"
input: "[null,false,1,\"x\",[],{}]"
output: "false\nfalse\nfalse\nfalse\nfalse\nfalse\n"

case: "types-infinite-json-value"
filter: "infinite"
input: "null"
output: "1.7976931348623157e+308\n"

case: "types-generated-infinite-is-classified"
filter: "infinite|isinfinite"
input: "null"
output: "true\n"

case: "types-nan-json-value"
filter: "nan"
input: "null"
output: "null\n"

case: "types-generated-nan-is-classified"
filter: "nan|isnan"
input: "null"
output: "true\n"

case: "types-generated-nan-is-not-infinite"
filter: "nan|isinfinite"
input: "null"
output: "false\n"

case: "types-generated-infinite-is-not-nan"
filter: "infinite|isnan"
input: "null"
output: "false\n"

case: "types-toarray-wraps-scalar"
filter: "toarray"
input: "1"
output: "[1]\n"
divergence: "tq provides the requested scalar-to-array coercion; jq 1.7.1 has no toarray builtin"
jq-output: "error: toarray/0 is not defined"

case: "types-toarray-keeps-array"
filter: "toarray"
input: "[1,2]"
output: "[1,2]\n"
divergence: "tq provides the requested scalar-to-array coercion; jq 1.7.1 has no toarray builtin"
jq-output: "error: toarray/0 is not defined"

case: "types-toarray-normalizes-generated-numbers"
filter: "nan|toarray"
input: "null"
output: "[null]\n"
divergence: "tq provides the requested scalar-to-array coercion; jq 1.7.1 has no toarray builtin"
jq-output: "error: toarray/0 is not defined"

case: "types-unsupported-isfinite"
filter: "isfinite"
input: "1"
error: "unsupported identifier `isfinite`"

case: "types-unsupported-isnormal"
filter: "isnormal"
input: "1"
error: "unsupported identifier `isnormal`"

case: "types-unsupported-finites"
filter: "finites"
input: "1"
error: "unsupported identifier `finites`"

case: "types-unsupported-normals"
filter: "normals"
input: "1"
error: "unsupported identifier `normals`"
