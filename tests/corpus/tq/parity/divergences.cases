# Deliberate tq semantics. Each jq-output records jq 1.7.1's outcome.
case: "divergence-string-path-on-array"
filter: ".x"
input: "[1]"
output: "null\n"
divergence: "tq treats a missing named path on a non-object as null"
jq-output: "error: Cannot index array with string \"x\""

case: "divergence-index-on-object"
filter: ".[0]"
input: "{\"a\":1}"
output: "null\n"
divergence: "tq treats an array index on a non-array as null"
jq-output: "error: Cannot index object with number"

case: "divergence-iteration-on-object"
filter: ".[]"
input: "{\"a\":1}"
output: "null\n"
divergence: "tq iteration is array-only and yields null for other values"
jq-output: "1\n"

case: "divergence-number-has-on-object"
filter: "has(1)"
input: "{\"team\":\"core\"}"
output: "false\n"
divergence: "tq stringifies a numeric object key before checking it"
jq-output: "error: Cannot check whether object has a number key"

case: "divergence-number-has-on-numeric-key"
filter: "has(1)"
input: "{\"1\":\"core\"}"
output: "true\n"
divergence: "tq stringifies a numeric object key before checking it"
jq-output: "error: Cannot check whether object has a number key"

case: "divergence-chainable-comparison"
filter: "1 < 2 < 3"
input: "null"
output: "true\n"
divergence: "tq deliberately accepts left-associative comparison chains"
jq-output: "error: syntax error"
