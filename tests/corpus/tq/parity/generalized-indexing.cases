# Generalized jq-compatible indexing, slicing, and iteration.
case: "index-negative"
filter: ".[ -1 ]"
input: "[10,20,30]"
output: "30\n"

case: "slice-negative-bounds"
filter: ".[ -3:-1 ]"
input: "[0,1,2,3,4]"
output: "[2,3]\n"

case: "index-bracket-string"
filter: ".[\"k\"]"
input: "{\"k\":42}"
output: "42\n"

case: "index-filter-expression"
filter: ".[.selector]"
input: "{\"selector\":\"answer\",\"answer\":42}"
output: "42\n"

case: "index-filter-stream"
filter: ".[0,2]"
input: "[10,20,30]"
output: "10\n30\n"

case: "iteration-object-values"
filter: ".[]"
input: "{\"first\":1,\"second\":2}"
output: "1\n2\n"

case: "iteration-null-error"
filter: ".[]"
input: "null"
error: "Cannot iterate over null"

case: "iteration-scalar-error"
filter: ".[]"
input: "1"
error: "Cannot iterate over number"

case: "iteration-optional-suppresses-error"
filter: ".[]?"
input: "1"
output: ""
