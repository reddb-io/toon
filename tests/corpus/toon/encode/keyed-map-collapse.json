{
  "category": "encode",
  "tests": [
    {
      "name": "keyed map collapse encodes byte-for-byte",
      "input": {
        "people": {
          "joe": {
            "first": "Joe",
            "last": "Schmoe"
          },
          "mary": {
            "first": "Mary",
            "last": "Jane"
          }
        }
      },
      "expected": "people[2:]{first,last}:\n  joe: Joe,Schmoe\n  mary: Mary,Jane"
    },
    {
      "name": "non-uniform map falls back to ordinary object form",
      "input": {
        "people": {
          "joe": {
            "first": "Joe",
            "last": "Schmoe"
          },
          "mary": {
            "first": "Mary",
            "role": "admin"
          }
        }
      },
      "expected": "people:\n  joe:\n    first: Joe\n    last: Schmoe\n  mary:\n    first: Mary\n    role: admin"
    }
  ]
}
