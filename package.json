{
  "name": "tq-workspace",
  "version": "0.21.0",
  "private": true,
  "description": "pnpm workspace for the JavaScript packages published from reddb-io/toon.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "benchmark:accuracy": "node benchmarks/accuracy/run.mjs",
    "benchmark:accuracy:verify": "node --test benchmarks/accuracy/verify.test.mjs",
    "benchmark:performance": "node benchmarks/performance/run.mjs",
    "benchmark:tokens": "node benchmarks/tokens/run.mjs",
    "wire:corpora": "node scripts/generate_wire_efficiency_corpora.mjs",
    "wire:tokens": "node scripts/wire_efficiency_token_report.mjs",
    "test": "pnpm -r test",
    "check:upstream": "node scripts/upstream-drift.mjs",
    "test:upstream": "node --test scripts/upstream-drift.test.mjs scripts/upstream-release-watch.test.mjs",
    "test:upstream-package": "vitest run --config scripts/upstream-package-suite/vitest.config.mjs",
    "lint": "pnpm -r --if-present lint",
    "version": "bash scripts/sync-version.sh \"$npm_package_version\" && git add -- Cargo.toml Cargo.lock crates/tq/Cargo.toml package.json packages/toon/package.json packages/toon/src/version.ts packages/toon/dist/version.js packages/vscode-toon/package.json",
    "check:versions": "node --test scripts/release-version.test.mjs && bash scripts/check-versions.sh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/tq.git"
  },
  "devDependencies": {
    "@toon-format/spec": "file:vendor/toon-spec",
    "gpt-tokenizer": "3.4.0",
    "vitest": "3.2.4"
  }
}
