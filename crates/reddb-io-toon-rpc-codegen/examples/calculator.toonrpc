# The Calculator service: the IDL behind the generated code in
# crates/reddb-io-toon-rpc-examples/src/calculator_api.rs and
# packages/toon-rpc/test/generated/calculator.ts.
service: Calculator
version: "1.0"
types:
  Vec2:
    x: f64
    y: f64
  Stats:
    count: u32
    mean: f64?
methods[4]:
  - name: add
    params:
      a: f64
      b: f64
    result: f64
  - name: divide
    params:
      a: f64
      b: f64
    result: f64
  - name: norm
    params:
      v: Vec2
    result: f64
  - name: stats
    params:
      values: f64[]
    result: Stats
